{
  "manifest_version": 3,
  "name": "Media Toolkit",
  "version": "3.1",
  "description": "Copy images, download videos, extract audio and transcribe Instagram Reels — transcription runs 100% locally in your browser",
  "permissions": [
    "contextMenus",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://www.instagram.com/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs-us-1.huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["transcript-panel.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
